{
  "name": "chatloop-admin",
  "version": "0.1.0",
  "private": true,
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "arrowParens": "always",
    "semi": true
  },
  "dependencies": {
    "@hookform/resolvers": "^2.8.0",
    "@material-ui/core": "^4.11.4",
    "@material-ui/icons": "^4.11.2",
    "axios": "^0.21.1",
    "clsx": "^1.1.1",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-hook-form": "^7.15.3",
    "react-infinite-scroll-component": "^6.1.0",
    "react-phone-input-material-ui": "^2.17.4",
    "react-router-dom": "^5.1.2",
    "react-scripts": "^5.0.0",
    "react-scroll": "^1.8.2",
    "react-select": "^4.3.1",
    "typeface-lato": "^1.1.13",
    "uuid": "^8.3.2",
    "yup": "^0.32.9"
  },
  "scripts": {
    "start": "react-scripts -r @cypress/instrument-cra start",
    "start:dev": "env-cmd -f ./src/config/local.env yarn start",
    "start:staging": "env-cmd -f ./src/config/staging.env yarn start",
    "build": "react-scripts build",
    "build:staging": "env-cmd -f ./src/config/staging.env yarn build",
    "build:prod": "env-cmd -f ./src/config/prod.env yarn build",
    "test": "env-cmd -f ./src/config/local.env react-scripts test",
    "test:staging": "env-cmd -f ./src/config/staging.env react-scripts test",
    "eject": "react-scripts eject",
    "cypress:open": "cypress open",
    "cypress:all": "cypress run",
    "test:ci": "npm test -- --ci && npm run cypress:all",
    "test:combined": "npm test a -- --watchAll=false && npm run cypress:all",
    "test:coverage": "npm run clear:nyc && npm run test:combined && node ./scripts/mergeCoverage.js && open coverage-combined/lcov-report/index.html",
    "clear:nyc": "if [ -d '.nyc_output/' ]; then rm -rf .nyc_output/; fi",
    "prettier:check": "yarn prettier --check .",
    "prettier:write": "yarn prettier --write ."
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.9.6",
    "@cypress/instrument-cra": "^1.4.0",
    "@cypress/react": "^5.9.1",
    "@cypress/webpack-dev-server": "^1.3.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^11.2.7",
    "@types/jest": "^26.0.23",
    "@types/moment": "^2.13.0",
    "@types/moment-timezone": "^0.5.13",
    "@types/moxios": "^0.4.9",
    "@types/react-dom": "^17.0.11",
    "@types/react-infinite-scroll-component": "^5.0.0",
    "@types/react-router-dom": "^5.1.3",
    "@types/react-scroll": "^1.5.4",
    "@types/react-select": "^4.0.15",
    "@types/uuid": "^8.3.0",
    "@types/yup": "^0.29.11",
    "cypress": "^7.5.0",
    "cypress-localstorage-commands": "^1.4.5",
    "env-cmd": "^10.1.0",
    "moxios": "^0.4.0",
    "prettier": "^2.5.1",
    "typescript": "^4.3.2"
  },
  "nyc": {
    "report-dir": "coverage-cypress",
    "exclude": []
  },
  "jest": {
    "coverageReporters": [
      "json"
    ]
  }
}
